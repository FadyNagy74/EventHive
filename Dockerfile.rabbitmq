FROM rabbitmq:4.2-management
COPY plugins/rabbitmq_delayed_message_exchange-4.2.0.ez /opt/rabbitmq/plugins/
RUN rabbitmq-plugins enable --offline rabbitmq_delayed_message_exchange
# Copy definitions (users, permissions, topology)
COPY definitions.json /etc/rabbitmq/definitions.json

# Tell RabbitMQ to import definitions on startup
RUN printf "definitions.import_backend = local_filesystem\ndefinitions.local.path = /etc/rabbitmq/definitions.json\n" > /etc/rabbitmq/conf.d/definitions.conf
