{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Consul": {
    "Host": "http://localhost:8500"
  },
  "ReverseProxy": {
    "Routes": {
      "authentication-route": {
        "ClusterId": "authentication-service",
        "Match": {
          "Path": "/api/authentication/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-service",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-service",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-service",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      }
    }
  }
}