{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host":        "localhost",
    "VirtualHost": "/"
  },
  "Consul": {
    "Host": "http://localhost:8500",
    "ServiceName": "catalog-service",
    "ServiceHost": "localhost",
    "ServicePort": 5041,
    "HealthCheckPath": "/health",
    "HealthCheckInterval": "10s",
    "HealthCheckTimeout": "5s",
    "DeregisterCriticalServiceAfter": "1m"
  }
}