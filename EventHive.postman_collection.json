{
  "info": {
    "_postman_id": "0b7d47ea-1457-4c32-8fe8-d8a0e18ce240",
    "name": "EventHive",
    "description": "Complete API collection for the EventHive microservices platform.\n\nAll requests are routed through the API Gateway at https://localhost:7107.\n\n## Setup\n1. Run the Google OAuth2 login flow in your browser: https://localhost:7107/api/authentication/google-login\n2. Copy the `accessToken` from the response.\n3. Set the `access_token` collection variable to the copied token.\n4. All authenticated requests will automatically use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "40568631",
    "_collection_link": "https://go.postman.co/collection/40568631-0b7d47ea-1457-4c32-8fe8-d8a0e18ce240?source=collection_link"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Google Login (open in browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/authentication/google-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authentication",
                "google-login"
              ]
            },
            "description": "Initiates the Google OAuth2 login flow.\n\nThis URL must be opened in a browser — it redirects to Google's sign-in page. Postman cannot follow the OAuth redirect chain.\n\nTest account:\n- Email: fadynagytest@gmail.com\n- Password: fadynagytest@1\n\nAfter Google redirects back, copy the `accessToken` from the JSON response and paste it into the `access_token` collection variable."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "    console.log('Tokens updated from refresh response.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/authentication/refresh-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authentication",
                "refresh-token"
              ]
            },
            "description": "Exchange a refresh token for a new access token.\n\nRefresh tokens rotate — the submitted token is revoked and a brand-new token pair is returned.\n\nToken lifetime:\n- Access token: 30 minutes\n- Refresh token: 14 days\n\nThe test script automatically updates the `access_token` and `refresh_token` collection variables on success."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"<your-refresh-token>\"\n}"
                },
                "url": {
                  "raw": ""
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "Text",
              "header": [],
              "cookie": [],
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"accessTokenExpiresAt\": \"2026-10-07T15:00:00Z\",\n  \"refreshToken\": \"new-refresh-token...\",\n  \"userId\": \"a1b2c3d4-...\",\n  \"email\": \"fadynagytest@gmail.com\",\n  \"name\": \"Fady Nagy\"\n}"
            }
          ]
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/authentication/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authentication",
                "me"
              ]
            },
            "description": "Returns the profile of the currently authenticated user.\n\nRequires a valid Bearer JWT in the Authorization header."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{access_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/authentication/me",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "authentication",
                    "me"
                  ]
                },
                "description": "Returns the profile of the currently authenticated user.\n\nRequires a valid Bearer JWT in the Authorization header."
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "Text",
              "header": [],
              "cookie": [],
              "body": "{\n  \"id\": \"a1b2c3d4-...\",\n  \"email\": \"fadynagytest@gmail.com\",\n  \"name\": \"Fady Nagy\"\n}"
            }
          ]
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/authentication/sign-out",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "authentication",
                "sign-out"
              ]
            },
            "description": "Revokes the current user's refresh token.\n\nAfter calling this, the stored refresh token is invalidated. The access token will still work until it expires (30 minutes), but it cannot be refreshed.\n\nRequires a valid Bearer JWT."
          },
          "response": []
        }
      ],
      "description": "Authentication Service endpoints — Google OAuth2 login, token refresh, profile, and sign-out."
    },
