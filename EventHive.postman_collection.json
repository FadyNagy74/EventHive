              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/catalog/event/adjust-remaining-seats/{{event_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "catalog",
                "event",
                "adjust-remaining-seats",
                "{{event_id}}"
              ]
            },
            "description": "Manually adjusts the remaining seat count for an event.\n\nEvery adjustment is written to the ManualCapacityAdjustments audit log with the admin's user ID, name, and the reason provided.\n\nConstraints:\n- remainingSeats: required, must be >= 0\n- reason: required, minimum 5 characters\n\nRequires Admin role."
          },
          "response": []
        }
      ],
      "description": "Admin-only catalog management endpoints.\n\nAll requests in this folder require a JWT with the Admin role.\nAssign the Admin role in the EventHiveAuth database, then re-login to get a new token that includes the role claim."
