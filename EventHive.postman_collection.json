                "catalog",
                "event",
                "close",
                "{{event_id}}"
              ]
            },
            "description": "Transitions a Published event to Closed status.\n\nBlocks new bookings. Existing confirmed bookings are unaffected. The event can still be fetched by ID.\n\nRequires Admin role."
          },
          "response": []
        },
        {
          "name": "Cancel Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/catalog/event/cancel/{{event_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "catalog",
                "event",
                "cancel",
                "{{event_id}}"
              ]
            },
            "description": "Cancels an event, transitioning it to the Cancelled status.\n\nWhen fully implemented, this will publish an EventCancelled message that triggers Booking to cancel associated bookings and Notification to inform affected users.\n\nRequires Admin role."
          },
          "response": []
        },
